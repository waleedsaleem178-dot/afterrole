{
  "expo": {
    "name": "afterrole",
    "slug": "afterrole",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/afterrole-icon.png",
    "scheme": "afterrole",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/afterrole-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/afterrole-mark-forest.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#112A21",
          "image": "./assets/brand/afterrole-mark-ivory.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
