# AfterRole environment variables
#
# Copy this file to `.env` and fill in your Supabase project values.
# Only EXPO_PUBLIC_* vars are exposed to the app at runtime (client-safe).
# The anon key is a PUBLIC key (protected by Row Level Security) — safe to ship.
# Never put the service_role key here or in the app; it bypasses RLS.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-public-key
